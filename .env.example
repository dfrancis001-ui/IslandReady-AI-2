# IslandReady AI — local development variables (PLACEHOLDERS ONLY)
# Copy to `.env` and fill in real LOCAL values. Never commit `.env`.
# Never put real passwords, keys, or secrets in this file.

# Local PostgreSQL (set up after the owner installs PostgreSQL on Windows).
# Format: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/islandready_dev

# Auth.js (wired in Phase 1, not before). Generate a random local value later;
# e.g. run: openssl rand -base64 32   (or: python -c "import secrets; print(secrets.token_hex(32))")
NEXTAUTH_SECRET=replace-with-random-local-value
NEXTAUTH_URL=http://localhost:3000

# RAG providers (Phase 7+; local Ollama, server-side only — never NEXT_PUBLIC_).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:1b
